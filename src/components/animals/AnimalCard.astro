---
const { animal } = Astro.props;
const tone = animal.TipoAnimal === 'Perro' ? 'bg-sun/30' : 'bg-coral/20';
---
<article class={`animal-card group rounded-3xl border border-ink/10 ${tone} p-5 transition hover:-translate-y-1 hover:shadow-soft`}>
  <div class="flex items-start justify-between">
    <span class="rounded-full bg-white/80 px-3 py-1 text-xs font-bold uppercase tracking-wider text-ink">{animal.TipoAnimal}</span>
    <span class="text-2xl" aria-hidden="true">{animal.TipoAnimal === 'Perro' ? '🐶' : '🐱'}</span>
  </div>
  <h3 class="mt-8 font-display text-3xl text-ink">{animal.Nombre}</h3>
  <p class="mt-1 text-sm text-ink/70">{animal.Raza} · {animal.Edad} {animal.Edad === 1 ? 'año' : 'años'}</p>
  <div class="mt-5 flex items-center justify-between border-t border-ink/10 pt-4 text-xs font-semibold text-ink/60">
    <span>{animal.Sexo}</span>
    <a href={`/animals/edit?id=${animal.Identificador}`} class="font-bold text-ink underline decoration-sun decoration-2 underline-offset-4">Editar</a>
  </div>
</article>

