---
const { compact = false } = Astro.props;
---
<header class:list={["absolute left-0 top-0 z-20 w-full px-6 py-6 md:px-12", compact && "relative bg-ink"]}>
  <nav class="mx-auto flex max-w-7xl items-center justify-between" aria-label="Navegación principal">
    <a href="/" class="font-display text-xl font-bold tracking-tight text-white">
      <span class="mr-1 inline-flex h-7 w-7 items-center justify-center rounded-full bg-sun text-xs text-ink">✦</span>company
    </a>
    <div class="hidden items-center gap-7 rounded-full border border-white/50 px-6 py-2 text-[10px] font-bold uppercase tracking-widest text-white md:flex">
      <a href="/" class="hover:text-sun">Inicio</a>
      <a href="/#servicios" class="hover:text-sun">Servicios</a>
      <a href="/#consejos" class="hover:text-sun">Consejos</a>
      <a href="/login" class="hover:text-sun">Acceso</a>
    </div>
    <button id="menu-toggle" class="rounded-lg p-2 text-white md:hidden" aria-label="Abrir menú">☰</button>
  </nav>
  <div id="mobile-menu" class="mx-auto mt-4 hidden max-w-7xl rounded-2xl bg-white p-5 text-sm font-bold text-ink shadow-soft md:hidden">
    <a class="block py-2" href="/">Inicio</a>
    <a class="block py-2" href="/#servicios">Servicios</a>
    <a class="block py-2" href="/login">Acceso</a>
  </div>
</header>
<script>
  document.querySelector('#menu-toggle')?.addEventListener('click', () => document.querySelector('#mobile-menu')?.classList.toggle('hidden'));
</script>
