---
const { title, message = 'Aún no hay animales para mostrar.' } = Astro.props;
---
<div class="flex flex-col items-center justify-center rounded-3xl border border-dashed border-ink/15 bg-white px-6 py-16 text-center">
  <img src="/images/empty-paw.svg" alt="Huella decorativa" class="mb-5 h-20 w-20 opacity-80" />
  <h3 class="font-display text-2xl text-ink">{title ?? 'Todo tranquilo por aquí'}</h3>
  <p class="mt-2 max-w-sm text-sm text-ink/60">{message}</p>
</div>
