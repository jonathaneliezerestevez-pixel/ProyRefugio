---
import '../styles/global.css';

interface Props { title?: string; description?: string; }
const { title = 'Refugio · Pet lovers for life', description = 'Cuidamos, protegemos y encontramos hogares para nuestros animales.' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
