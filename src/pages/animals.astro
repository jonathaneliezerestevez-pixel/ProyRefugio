---
import Layout from '../layouts.astro';
---
<Layout><main style="max-width:75rem;margin:4rem auto;padding:2rem"><button id="logout">Cerrar sesión</button><h1>Animales</h1><form id="filter"><input name="nombre" placeholder="Nombre"/><input name="raza" placeholder="Raza"/><select name="sexo"><option value="">Sexo</option><option>Hembra</option><option>Macho</option></select><select name="tipoAnimal"><option value="">Tipo</option><option>Perro</option><option>Gato</option></select><button>Filtrar</button></form><div id="list"></div><h2>Registrar animal</h2><form id="create"><input name="nombre" placeholder="Nombre" required/><input name="raza" placeholder="Raza" required/><input name="edad" type="number" min="0" placeholder="Edad" required/><select name="sexo"><option>Hembra</option><option>Macho</option></select><select name="tipoAnimal"><option>Perro</option><option>Gato</option></select><button>Registrar</button></form><p id="m"></p></main></Layout>
<script>
import {animals,auth} from '../services/api';import {animalSchema} from '../schemas/schemas';import {authStore} from '../stores/auth';
if(!authStore.get())location.href='/login';const list=document.querySelector('#list'),m=document.querySelector('#m');
async function load(q:any={}){const a=await animals.list(q);if(list)list.innerHTML=a.map(x=>`<article><h2>${x.Nombre}</h2><p>${x.Raza} · ${x.Edad} años · ${x.Sexo} · ${x.TipoAnimal}</p><a href="/animals/edit?id=${x.Identificador}">Editar</a></article>`).join('')||'<p>No hay animales.</p>'}load();document.querySelector('#filter')?.addEventListener('submit',e=>{e.preventDefault();load(Object.fromEntries(new FormData(e.currentTarget as HTMLFormElement)))});document.querySelector('#logout')?.addEventListener('click',async()=>{try{await auth.logout()}catch{}authStore.clear();location.href='/login'});document.querySelector('#create')?.addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget as HTMLFormElement;const v=animalSchema.safeParse(Object.fromEntries(new FormData(f)));if(!v.success){if(m)m.textContent=v.error.issues[0].message;return}try{await animals.create(v.data);f.reset();load()}catch(x){if(m)m.textContent=x instanceof Error?x.message:'Error'}})
</script>
